{
  "manifest_version": 1,
  "library": "libamcore",
  "library_version": "0.6.1",
  "header": "amcore/amcore.h",
  "description": "Machine-readable metadata for the public C calculation API.",
  "status_codes": {
    "0": {"name": "AMCORE_STATUS_SUCCESS", "description": "Calculation succeeded."},
    "1": {"name": "AMCORE_STATUS_INVALID_ARGUMENT", "description": "Input outside the function-specific domain, non-finite input, or null output pointer."},
    "2": {"name": "AMCORE_STATUS_OUT_OF_RANGE", "description": "Calculation is not representable as a finite C double."}
  },
  "numeric_contract": {
    "c_type": "double",
    "inputs": "Finite and within the function-specific domain; JSON adapters must reject numbers not representable as finite C doubles.",
    "outputs": "Finite; functions may return zero or signed values where their mathematical domains allow. Output pointers are written only on success.",
    "on_error": "C output values remain unchanged."
  },
  "constants": {
    "speed_of_light_m_per_s": {"c_type": "double", "value": 299792458, "unit": "m/s"}
  },
  "functions": [
    {
      "name": "amcore_free_space_wavelength",
      "module": "utility",
      "description": "Compute free-space wavelength from frequency.",
      "input_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "frequency_hz": {"type": "number", "exclusiveMinimum": 0, "description": "Frequency in hertz.", "x-unit": "Hz"}
        },
        "required": ["frequency_hz"],
        "additionalProperties": false
      },
      "output": {"name": "wavelength_m", "c_type": "double *", "unit": "m"},
      "formula": "speed_of_light_m_per_s / frequency_hz",
      "example": {
        "inputs": {"frequency_hz": 1000000000},
        "return_value": 0,
        "output": {"wavelength_m": 0.299792458}
      }
    },
    {
      "name": "amcore_far_field_distance",
      "module": "farfield",
      "description": "Compute minimum far-field distance per IEEE Std 149-2021, section 7.1.2.",
      "input_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "frequency_hz": {"type": "number", "exclusiveMinimum": 0, "description": "Frequency in hertz.", "x-unit": "Hz"},
          "aperture_length_m": {"type": "number", "exclusiveMinimum": 0, "description": "Largest antenna aperture length in metres.", "x-unit": "m"}
        },
        "required": ["frequency_hz", "aperture_length_m"],
        "additionalProperties": false
      },
      "output": {"name": "distance_m", "c_type": "double *", "unit": "m"},
      "formula": "max(5 * aperture_length_m, 1.6 * wavelength_m, 2 * aperture_length_m^2 / wavelength_m)",
      "nested_call": "amcore_free_space_wavelength",
      "example": {
        "inputs": {"frequency_hz": 299792458, "aperture_length_m": 4},
        "return_value": 0,
        "output": {"distance_m": 32}
      }
    },
    {
      "name": "amcore_far_field_line_of_sight_km",
      "module": "farfield",
      "description": "Estimate line-of-sight range from height above ground.",
      "input_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "height_m": {"type": "number", "minimum": 0, "description": "Height above ground in metres.", "x-unit": "m"}
        },
        "required": ["height_m"],
        "additionalProperties": false
      },
      "output": {"name": "range_km", "c_type": "double *", "unit": "km"},
      "formula": "3.57 * sqrt(height_m)",
      "example": {
        "inputs": {"height_m": 100},
        "return_value": 0,
        "output": {"range_km": 35.7}
      }
    },
    {
      "name": "amcore_far_field_radio_horizon_km",
      "module": "farfield",
      "description": "Estimate radio horizon from height above ground.",
      "input_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "height_m": {"type": "number", "minimum": 0, "description": "Height above ground in metres.", "x-unit": "m"}
        },
        "required": ["height_m"],
        "additionalProperties": false
      },
      "output": {"name": "range_km", "c_type": "double *", "unit": "km"},
      "formula": "4.12 * sqrt(height_m)",
      "example": {
        "inputs": {"height_m": 100},
        "return_value": 0,
        "output": {"range_km": 41.2}
      }
    },
    {
      "name": "amcore_far_field_path_loss_db",
      "module": "farfield",
      "description": "Compute free-space path loss under far-field conditions.",
      "input_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "frequency_mhz": {"type": "number", "exclusiveMinimum": 0, "description": "Frequency in megahertz.", "x-unit": "MHz"},
          "range_km": {"type": "number", "exclusiveMinimum": 0, "description": "Separation in kilometres.", "x-unit": "km"},
          "transmit_gain_db": {"type": "number", "description": "Transmit antenna gain in decibels.", "x-unit": "dB"},
          "receive_gain_db": {"type": "number", "description": "Receive antenna gain in decibels.", "x-unit": "dB"}
        },
        "required": ["frequency_mhz", "range_km", "transmit_gain_db", "receive_gain_db"],
        "additionalProperties": false
      },
      "output": {"name": "path_loss_db", "c_type": "double *", "unit": "dB"},
      "formula": "32.45 + 20 * log10(frequency_mhz * range_km) - transmit_gain_db - receive_gain_db",
      "example": {
        "inputs": {"frequency_mhz": 100, "range_km": 1, "transmit_gain_db": 0, "receive_gain_db": 0},
        "return_value": 0,
        "output": {"path_loss_db": 72.45}
      }
    },
    {
      "name": "amcore_near_field_separation_distance_m",
      "module": "nearfield",
      "description": "Compute the recommended near-field measurement separation as five free-space wavelengths.",
      "input_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "frequency_hz": {"type": "number", "exclusiveMinimum": 0, "description": "Frequency in hertz.", "x-unit": "Hz"}
        },
        "required": ["frequency_hz"],
        "additionalProperties": false
      },
      "output": {"name": "separation_m", "c_type": "double *", "unit": "m"},
      "formula": "5 * speed_of_light_m_per_s / frequency_hz",
      "reference": "IEEE Std 1720-2012, section 5.3.1.4",
      "example": {
        "inputs": {"frequency_hz": 10000000000},
        "return_value": 0,
        "output": {"separation_m": 0.149896229}
      }
    },
    {
      "name": "amcore_near_field_planar_sampling_spacing_m",
      "module": "nearfield",
      "description": "Compute planar near-field sampling spacing as half the free-space wavelength.",
      "input_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "frequency_hz": {"type": "number", "exclusiveMinimum": 0, "description": "Frequency in hertz.", "x-unit": "Hz"}
        },
        "required": ["frequency_hz"],
        "additionalProperties": false
      },
      "output": {"name": "spacing_m", "c_type": "double *", "unit": "m"},
      "formula": "0.5 * speed_of_light_m_per_s / frequency_hz",
      "example": {
        "inputs": {"frequency_hz": 299792458},
        "return_value": 0,
        "output": {"spacing_m": 0.5}
      }
    },
    {
      "name": "amcore_near_field_planar_scan_length_m",
      "module": "nearfield",
      "description": "Compute required centered planar scan length for an angle of view.",
      "input_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "aperture_cross_section_m": {"type": "number", "minimum": 0, "description": "Antenna cross-section length in metres.", "x-unit": "m"},
          "probe_separation_m": {"type": "number", "exclusiveMinimum": 0, "description": "Probe separation in metres.", "x-unit": "m"},
          "angle_of_view_deg": {"type": "number", "minimum": 0, "exclusiveMaximum": 90, "description": "Desired angle of view in degrees.", "x-unit": "deg"}
        },
        "required": ["aperture_cross_section_m", "probe_separation_m", "angle_of_view_deg"],
        "additionalProperties": false
      },
      "output": {"name": "scan_length_m", "c_type": "double *", "unit": "m"},
      "formula": "2 * probe_separation_m * tan(angle_of_view_deg * pi / 180) + aperture_cross_section_m",
      "example": {
        "inputs": {"aperture_cross_section_m": 1, "probe_separation_m": 2, "angle_of_view_deg": 45},
        "return_value": 0,
        "output": {"scan_length_m": 5}
      }
    },
    {
      "name": "amcore_near_field_planar_angle_of_view_deg",
      "module": "nearfield",
      "description": "Compute the planar near-field angle of view for a centered scan.",
      "input_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "aperture_cross_section_m": {"type": "number", "minimum": 0, "description": "Antenna cross-section length in metres.", "x-unit": "m"},
          "probe_separation_m": {"type": "number", "exclusiveMinimum": 0, "description": "Probe separation in metres.", "x-unit": "m"},
          "scan_length_m": {"type": "number", "minimum": 0, "description": "Scan length in metres.", "x-unit": "m"}
        },
        "required": ["aperture_cross_section_m", "probe_separation_m", "scan_length_m"],
        "additionalProperties": false
      },
      "output": {"name": "angle_of_view_deg", "c_type": "double *", "unit": "deg"},
      "formula": "atan2(scan_length_m - aperture_cross_section_m, 2 * probe_separation_m) * 180 / pi",
      "example": {
        "inputs": {"aperture_cross_section_m": 1, "probe_separation_m": 2, "scan_length_m": 5},
        "return_value": 0,
        "output": {"angle_of_view_deg": 45}
      }
    },
    {
      "name": "amcore_near_field_planar_sampling_parameters",
      "module": "nearfield",
      "description": "Compute centered planar scan endpoints, sample count, and whole-millimetre spacing.",
      "input_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "frequency_hz": {"type": "number", "exclusiveMinimum": 0, "description": "Frequency in hertz.", "x-unit": "Hz"},
          "minimum_scan_length_m": {"type": "number", "minimum": 0, "description": "Desired minimum scan length in metres.", "x-unit": "m"}
        },
        "required": ["frequency_hz", "minimum_scan_length_m"],
        "additionalProperties": false
      },
      "outputs": [
        {"name": "scan_start_m", "c_type": "double *", "unit": "m"},
        {"name": "scan_stop_m", "c_type": "double *", "unit": "m"},
        {"name": "sample_count", "c_type": "size_t *"},
        {"name": "sampling_spacing_mm", "c_type": "size_t *", "unit": "mm"}
      ],
      "formula": "spacing_mm=floor((0.5*speed_of_light_m_per_s/frequency_hz)*1000); half_scan_mm=ceil(ceil(minimum_scan_length_m*1000)/2) rounded up to a spacing_mm multiple; sample_count=2*half_scan_mm/spacing_mm+1",
      "example": {
        "inputs": {"frequency_hz": 299792458, "minimum_scan_length_m": 1},
        "return_value": 0,
        "outputs": {"scan_start_m": -0.5, "scan_stop_m": 0.5, "sample_count": 3, "sampling_spacing_mm": 500}
      }
    },
    {
      "name": "amcore_near_field_spherical_maximum_radius_extent_m",
      "module": "nearfield",
      "description": "Compute the spherical near-field maximum radius extent from three axis displacements.",
      "input_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "displacement_x_m": {"type": "number", "description": "Maximum x displacement in metres.", "x-unit": "m"},
          "displacement_y_m": {"type": "number", "description": "Maximum y displacement in metres.", "x-unit": "m"},
          "displacement_z_m": {"type": "number", "description": "Maximum z displacement in metres.", "x-unit": "m"}
        },
        "required": ["displacement_x_m", "displacement_y_m", "displacement_z_m"],
        "additionalProperties": false
      },
      "output": {"name": "extent_m", "c_type": "double *", "unit": "m"},
      "formula": "sqrt(displacement_x_m^2 + displacement_y_m^2 + displacement_z_m^2)",
      "example": {
        "inputs": {"displacement_x_m": 3, "displacement_y_m": 4, "displacement_z_m": 12},
        "return_value": 0,
        "output": {"extent_m": 13}
      }
    }
  ]
}

function(check_details function id count)
    execute_process(COMMAND "${AMCORE_CLI}" history --function "${function}" --id "${id}"
        RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error)
    if(NOT status STREQUAL "0" OR NOT error STREQUAL "")
        message(FATAL_ERROR "Detail lookup failed: '${output}', '${error}'")
    endif()
    string(REGEX MATCHALL "Function: ${function}  Version: [^\r\n]+  ID: ${id}" matches "${output}")
    list(LENGTH matches actual)
    if(NOT actual EQUAL count OR NOT output MATCHES "\\| Field +\\| Value +\\|")
        message(FATAL_ERROR "Incorrect detail tables: '${output}'")
    endif()
    set(detail_output "${output}" PARENT_SCOPE)
endfunction()

check_details(amcore_free_space_wavelength 1 2)
if(NOT detail_output MATCHES "Version: unknown" OR
   NOT detail_output MATCHES "Version: ${AMCORE_VERSION}" OR
   NOT detail_output MATCHES "\\| wavelength_m +\\| 1.0 +\\|")
    message(FATAL_ERROR "Missing cross-version details/output: '${detail_output}'")
endif()
check_details(amcore_far_field_distance 1 1)
if(NOT detail_output MATCHES "Version: 0.1.0" OR
   NOT detail_output MATCHES "\\| old_output +\\| NULL +\\|" OR
   NOT detail_output MATCHES "\\| frequency_hz +\\| NaN +\\|" OR
   NOT detail_output MATCHES "\\| output_is_null +\\| 0 +\\|")
    message(FATAL_ERROR "Missing legacy version/NULL details: '${detail_output}'")
endif()
string(FIND "${detail_output}" "first\\x0Asecond\\x09\\x7C\\x5C" escaped)
if(escaped EQUAL -1)
    message(FATAL_ERROR "Control characters were not escaped in details: '${detail_output}'")
endif()
file(SHA256 "${database}" after)
if(NOT before STREQUAL after)
    message(FATAL_ERROR "History modified the log database")
endif()


if(NOT DEFINED AMCORE_CLI OR NOT DEFINED HISTORY_FIXTURE OR
   NOT DEFINED HISTORY_ROOT OR NOT DEFINED AMCORE_VERSION)
    message(FATAL_ERROR "History test paths and version are required")
endif()

function(set_user name)
    set(root "${HISTORY_ROOT}/${name}")
    set(ENV{LOCALAPPDATA} "${root}")
    set(ENV{XDG_DATA_HOME} "${root}")
    set(ENV{HOME} "${root}")
    if(APPLE)
        set(root "${root}/Library/Application Support")
    endif()
    set(database "${root}/libamcore/libamcore.db" PARENT_SCOPE)
endfunction()

function(check_history expected_status expected_rows)
    execute_process(COMMAND "${AMCORE_CLI}" history ${ARGN}
        RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error)
    if(NOT status STREQUAL "${expected_status}")
        message(FATAL_ERROR "history ${ARGN}: status=${status}, stderr='${error}'")
    endif()
    if(expected_status EQUAL 0)
        if(NOT error STREQUAL "")
            message(FATAL_ERROR "Unexpected history diagnostic: ${error}")
        endif()
        string(REPLACE "\r\n" "\n" output "${output}")
        if(NOT output MATCHES "^\\+-[-+]+\n\\| ID +\\| Function +\\| Version +\\|")
            message(FATAL_ERROR "Expected bordered table with ID first: '${output}'")
        endif()
        string(REPLACE "\n" ";" table_lines "${output}")
        set(normalized "executed_at_us\tfunction\tversion\treturn_value\tduration_ns\tid\n")
        set(width 0)
        foreach(line IN LISTS table_lines)
            if(line STREQUAL "")
                continue()
            endif()
            string(LENGTH "${line}" length)
            if(width EQUAL 0)
                set(width ${length})
            elseif(NOT length EQUAL width)
                message(FATAL_ERROR "Table columns are not aligned: '${output}'")
            endif()
            if(line MATCHES "^\\| ([0-9]+) +\\| ([^ ]+) +\\| ([^ ]+) +\\| ([0-9]+) +\\| ([0-9]+) +\\| ([0-9]+) +\\|$")
                string(APPEND normalized
                    "${CMAKE_MATCH_4}\t${CMAKE_MATCH_2}\t${CMAKE_MATCH_3}\t${CMAKE_MATCH_5}\t${CMAKE_MATCH_6}\t${CMAKE_MATCH_1}\n")
            endif()
        endforeach()
        set(output "${normalized}")
        string(REGEX MATCHALL "\n" lines "${output}")
        list(LENGTH lines count)
        math(EXPR wanted "${expected_rows}+1")
        if(NOT count EQUAL wanted OR NOT output MATCHES
           "^executed_at_us\tfunction\tversion\treturn_value\tduration_ns\tid\n")
            message(FATAL_ERROR "Expected ${expected_rows} history rows, got '${output}'")
        endif()
    elseif(NOT output STREQUAL "" OR error STREQUAL "")
        message(FATAL_ERROR "Expected diagnostic only, got '${output}', '${error}'")
    endif()
    set(history_output "${output}" PARENT_SCOPE)
endfunction()

function(make_fixture mode)
    get_filename_component(directory "${database}" DIRECTORY)
    file(MAKE_DIRECTORY "${directory}")
    file(REMOVE "${database}")
    execute_process(COMMAND "${HISTORY_FIXTURE}" "${database}" "${mode}"
        RESULT_VARIABLE status ERROR_VARIABLE error)
    if(NOT status STREQUAL "0")
        message(FATAL_ERROR "Cannot create history fixture: ${error}")
    endif()
endfunction()

set_user(missing)
file(REMOVE "${database}")
foreach(help IN ITEMS help -h --help)
    execute_process(COMMAND "${AMCORE_CLI}" history ${help}
        RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error)
    if(NOT status STREQUAL "0" OR NOT error STREQUAL "" OR
       NOT output MATCHES "default: 10")
        message(FATAL_ERROR "History help failed: '${output}', '${error}'")
    endif()
endforeach()
check_history(1 0)
get_filename_component(directory "${database}" DIRECTORY)
if(EXISTS "${directory}")
    message(FATAL_ERROR "History created a missing database directory")
endif()
foreach(invalid IN ITEMS 0 -1 1.5 abc nan 1e2 9223372036854775808 "" " 2" +2)
    check_history(1 0 --limit "${invalid}")
endforeach()
check_history(1 0 --limit)
check_history(1 0 -l)
check_history(1 0 --unknown)
check_history(1 0 extra)
check_history(1 0 -l 1 --limit 2)
check_history(1 0 --help extra)
check_history(1 0 --id 1)
check_history(1 0 --function)
check_history(1 0 --function bad --id 1)
check_history(1 0 --function "amcore_x';DROP TABLE x" --id 1)
check_history(1 0 --function amcore_x --function amcore_y)
check_history(1 0 --function amcore_x --id 1 --id 2)
check_history(1 0 --function amcore_x --id 1 --limit 1)
foreach(invalid IN ITEMS 0 -1 abc 1.5 9223372036854775808)
    check_history(1 0 --function amcore_x --id "${invalid}")
endforeach()

